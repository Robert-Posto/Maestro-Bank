# Copiază acest fișier în .env și ajustează valorile pentru mediul tău local.
# .env NU trebuie urcat în Git (e deja în .gitignore) — nu pune aici secrete reale.

# MongoDB — fiecare serviciu își adaugă propriul nume de bază la finalul
# ăsteia (ex. /auth_db) — vezi docker-compose.yml. Două variante, alege UNA:
#
# 1) Atlas (implicit, recomandat) — cluster gratuit M0, partajat de toată
#    echipa, date de demo persistente și comune. Ia connection string-ul
#    din Atlas → Connect → Drivers, fără partea de după host (/? sau /<db>?...).
#    NU merge dacă rețeaua ta blochează portul 27017 spre exterior (ex.
#    firewall de companie) — vezi varianta 2 în acel caz.
MONGODB_URI_BASE=mongodb+srv://<user>:<password>@<cluster-host>.mongodb.net
#
# 2) Mongo local (fallback, când Atlas nu e accesibil din rețeaua ta) —
#    folosește containerul `mongodb` din docker-compose.yml, pornit automat
#    alături de restul. Datele NU sunt comune cu echipa, doar locale.
# MONGODB_URI_BASE=mongodb://mongodb:27017

# JWT — auth-service emite tokenul, gateway îl validează. Trebuie să fie
# IDENTIC în ambele servicii (vezi docker-compose.yml).
JWT_SECRET=change-me-in-development
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# CORS — origin-urile de development care pot apela API Gateway-ul.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# Rate limiting (API Gateway) — vezi backend/gateway/app/rate_limit.py
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60

# --- Email de verificare (onboarding) ---------------------------------
# Dacă SMTP_HOST rămâne gol, codul de verificare NU se trimite pe mail —
# apare doar în `docker logs maestrobank-auth-service`, suficient ca să
# testezi fluxul de onboarding fără cont de email real.
#
# Ca să trimiți email real cu Gmail: activează 2FA pe cont, apoi generează
# o "App password" (myaccount.google.com/apppasswords) — NU parola ta
# normală de Gmail, aia nu va funcționa cu SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@maestrobank.local
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15

# --- Seed de date demo (scripts/seed_demo_data.py) — STRICT development ---
# Nu sunt setate implicit în docker-compose.yml (opt-in explicit, doar
# atunci când rulezi scriptul de seed — vezi README, secțiunea "Date demo").
APP_ENV=development
ALLOW_DEMO_SEED=true
DEMO_USER_PASSWORD=ParolaDemo123

# --- AI Copilot: Spending + Forecast Agent (ai-orchestrator-service) ---
# Azure OpenAI, deployment GPT-5-mini. Fără astea setate, serviciul tot
# pornește (health check trece), dar orice cerere de chat întoarce 503.
# NU pune aici valori reale dacă acest fișier ajunge urcat undeva din
# greșeală — .env (nu .env.example) e locul pentru secrete reale.
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
AZURE_OPENAI_API_KEY=<azure-openai-api-key>
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Embeddings pentru RAG — OPȚIONALE. Nesetate = cad automat pe
# AZURE_OPENAI_ENDPOINT/API_KEY de mai sus (de obicei aceeași resursă),
# iar dacă TOT lipsesc, RAG-ul funcționează pe fallback local (TF-IDF).
# AZURE_OPENAI_EMBEDDING_ENDPOINT=https://<resource-name>.openai.azure.com
# AZURE_OPENAI_EMBEDDING_API_KEY=<azure-openai-api-key>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Twilio Lookup: verificare reală de operator la reîncărcarea de telefon
# (transactions-service, "Reîncarcă telefon" din Transferuri) — OPȚIONAL.
# Cont gratuit pe twilio.com (fără business KYC), Account SID + Auth Token
# din consolă. Nesetate = reîncărcarea funcționează normal, doar fără
# verificarea de operator (vezi app/twilio_client.py).
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>

# --- Duffel: preț real de zbor pentru MaestroAgent ("estimate_trip_cost",
# vezi ai-orchestrator-service) — OPȚIONAL. Cont gratuit pe app.duffel.com/join,
# fără aprobare — Access token din dashboard: nume echipă (stânga sus) ->
# Developers -> Access tokens -> New token. Un token de TEST
# (`duffel_test_...`, generat cu switch-ul "Test mode" activ) întoarce
# prețuri/companii reale, dar nu poate crea nicio comandă reală.
# Nesetat = agentul răspunde că nu poate estima preț real acum, în loc să
# inventeze o sumă.
DUFFEL_ACCESS_TOKEN=<duffel-test-access-token>
