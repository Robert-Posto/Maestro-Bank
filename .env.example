# Copiază acest fișier în .env și ajustează valorile pentru mediul tău local.
# .env NU trebuie urcat în Git (e deja în .gitignore) — nu pune aici secrete reale.

# MongoDB — folosit ca bază pentru connection string-urile per-serviciu
# (fiecare serviciu își adaugă propriul nume de bază, ex. /auth_db).
MONGO_URL=mongodb://mongodb:27017

# JWT — auth-service emite tokenul, gateway îl validează. Trebuie să fie
# IDENTIC în ambele servicii (vezi docker-compose.yml).
JWT_SECRET=change-me-in-development
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# CORS — origin-urile de development care pot apela API Gateway-ul.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# Rate limiting (API Gateway) — vezi backend/gateway/app/rate_limit.py
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60

# --- Seed de date demo (scripts/seed_demo_data.py) — STRICT development ---
# Nu sunt setate implicit în docker-compose.yml (opt-in explicit, doar
# atunci când rulezi scriptul de seed — vezi README, secțiunea "Date demo").
APP_ENV=development
ALLOW_DEMO_SEED=true
DEMO_USER_PASSWORD=ParolaDemo123
